# Production Environment Configuration
# Copy this to .env and fill in your actual values

# ============================================================================
# DATABASE
# ============================================================================
DATABASE_URL=postgresql+psycopg2://prabha_user:CHANGE_PASSWORD@localhost:5432/prabha_dairy

# Database Pool Settings (adjust based on your load)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=3600

# ============================================================================
# TALLY ERP CONNECTION
# ============================================================================
TALLY_HOST=127.0.0.1
TALLY_PORT=9000

# ============================================================================
# API SECURITY
# ============================================================================
# Generate a secure key: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_IN_PRODUCTION_USE_OPENSSL_RAND_HEX_32

# API Key Authentication (optional but recommended)
# Generate with: openssl rand -hex 16
# Include this in X-API-Key header for all requests
API_KEY=

# CORS - Comma-separated allowed origins (no spaces)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# ============================================================================
# SERVER CONFIGURATION
# ============================================================================
ENVIRONMENT=production
DEBUG=false
HOST=0.0.0.0
PORT=8000
WORKERS=4

# ============================================================================
# RATE LIMITING
# ============================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO
SQL_ECHO=false
