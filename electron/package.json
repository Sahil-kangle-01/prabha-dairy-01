{
  "name": "prabha-dairy-desktop",
  "version": "1.0.0",
  "description": "Electron wrapper for Prabha Dairy sync service",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "package": "electron-builder"
  },
  "build": {
    "appId": "com.prabhadairy.desktop",
    "files": [
      "main.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "python-backend",
        "to": "python-backend",
        "filter": ["**/*"]
      }
    ],
    "asarUnpack": [
      "python-backend/**"
    ],
    "win": {
      "target": ["nsis", "zip"]
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^24.13.3"
  }
}
